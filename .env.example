# ── 短剧发行中心 环境变量 ──────────────────────────────
# 真实后端：https://www.testshort.top （context-path /sqx_fast）
# 留空=走相对 /sqx_fast，由 vite dev 代理转发到真实后端（见 vite.config.ts server.proxy，规避跨域，推荐）。
# 直连后端（跨域，需后端开 CORS）则填：VITE_API_BASE=https://www.testshort.top
VITE_API_BASE=

# 业务数据 mock 开关：仅作用于「结算中心」(services/settlement)，因结算接口文档尚未提供，
# 暂仍走本地 mock。上剧 / 数据概览 / 入驻 / 登录 均已切真实接口，不受此开关影响。
VITE_USE_MOCK=true

# 联调回退 token（未走真实登录时使用；正式登录接入后由登录流程写入 localStorage）：
# - VITE_APP_TOKEN：App 主账号 JWT，用于 /app/**、/alioss/**（含入驻、语言列表、上传）
# - VITE_PUBLISHER_TOKEN：发行中心 publisher token，用于 /publisher/**（上剧/数据概览）；
#   可留空，由 byAppToken 用 appToken 自动换取
VITE_APP_TOKEN=
VITE_PUBLISHER_TOKEN=
