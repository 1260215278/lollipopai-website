{
	auto_https disable_redirects
}

# Lollipop Drama — Caddy Server Configuration
#
# Deploy: copy to /etc/caddy/Caddyfile (or import via caddy reload)
# This config assumes the built dist/ is served from /var/www/lollipop
# Adjust paths as needed for your deployment.

{$SITE_DOMAIN:www.lollipop.im} {
	tls internal
	root * /srv/www/lollipop/current

        # Short cache for llms.txt to force Cloudflare refresh
        header /llms*.txt Cache-Control "public, max-age=60"
        header /llms*.txt Surrogate-Control "public, max-age=0"
        header /llms*.txt CDN-Cache-Control "public, max-age=60"

	# Security HTTP headers
	header {
		# Force HTTPS (6 months = 15768000 seconds)
		Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
		# Prevent MIME-type sniffing
		X-Content-Type-Options "nosniff"
		# Prevent clickjacking (deny all framing)
		X-Frame-Options "DENY"
		# Control referrer information sent to external sites
		Referrer-Policy "strict-origin-when-cross-origin"
		# Content Security Policy — allow inline (React SPA) + self assets + Unsplash images
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' https:; frame-ancestors 'none'"
		# Permissions Policy — disable unnecessary browser features
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Remove server version header
		-Server
	}

	# ── /guides → /blog 301 重定向（2026-09-01 内容合并）──
	# 结构化知识区 /guides 的 9 篇指南已整体迁入 /blog 的「操作指南」分类，
	# 原 URL 全部永久重定向到新地址，保住已积累的外部链接与索引。
	# slug 保持不变，因此 /guides/<slug> → /blog/<slug> 是一一对应的。
	# 列表页与三个分类聚合页统一落到 /blog（新站已无对应聚合页）。
	#
	# ⚠️ Caddy 的指令按「最长路径优先」之外还有固定优先级：redir 属于
	#    rewrite 之前的阶段，放在这里不会被下面的 try_files / file_server 抢先。
	redir /guides/workflow /blog 301
	redir /guides/production /blog 301
	redir /guides/distribution /blog 301
	redir /guides/character-consistency-workflow /blog/character-consistency-workflow 301
	redir /guides/ten-episodes-two-weeks /blog/ten-episodes-two-weeks 301
	redir /guides/publish-and-monetize-vertical-drama /blog/publish-and-monetize-vertical-drama 301
	redir /guides/script-to-screen-pipeline /blog/script-to-screen-pipeline 301
	redir /guides/fix-ai-video-artifacts /blog/fix-ai-video-artifacts 301
	redir /guides/first-vertical-drama-zero-experience /blog/first-vertical-drama-zero-experience 301
	redir /guides/ai-drama-budget-under-1000 /blog/ai-drama-budget-under-1000 301
	redir /guides/multilingual-localization-workflow /blog/multilingual-localization-workflow 301
	redir /guides/ai-drama-legal-checklist /blog/ai-drama-legal-checklist 301
	# 兜底：/guides 本身及其余路径 → /blog
	redir /guides* /blog 301

	# ── P1-10 内容合并（2026-10-27）：消除同意图关键词内耗 ──
	# lollipop-vs-reelshort-dramabox 与 reelshort-alternative-lollipop-vs-reelshort-dramabox-2026
	# 是同一"ReelShort vs DramaBox 对比"意图的两篇，合并为前者
	redir /blog/reelshort-alternative-lollipop-vs-reelshort-dramabox-2026 /blog/lollipop-vs-reelshort-dramabox 301

	# ── /lollipop/* → /* 301（2026-09-05 根部署迁移）──
	# 生产环境（www.lollipop.im）实际把 dist 部署在网站根目录，但历史上构建产物里
	# canonical / sitemap / hreflang / JSON-LD 全部写死了 /lollipop/ 前缀，导致
	# sitemap 里 298 条 URL 100% 被 SPA 兜底成首页壳 → GSC 525 个页面未编入索引。
	# 现已把全站前缀剥离，这里把已被引擎收录的 /lollipop/... 旧 URL 301 到根路径，
	# 把已积累的权重传给新 URL，同时让 GSC 的「自动重定向」计数自然消化。
	redir /lollipop / 301

	@oldDeployPrefix path /lollipop/*
	handle @oldDeployPrefix {
		uri strip_prefix /lollipop
		redir * {uri} 301
	}

	# Compression: Brotli (preferred) + Gzip fallback
	# Brotli 压缩率比 gzip 高 15-25%，对 HTML/JS/CSS 效果显著。
	# 配合 build 阶段生成的 .br / .gz 预压缩文件，Caddy 直接返回无需实时压缩。
	encode zstd gzip

	# ── AI-only pages: /press and /glossary ──
	# These pages serve structured data (MediaGallery, DefinedTermSet) for AI
	# crawlers to cite in generative search results. Human users are redirected
	# to the homepage — the pages exist purely for GEO (Generative Engine
	# Optimization), not for human navigation.
	#
	# Approach: redir is evaluated before handle/file_server in Caddy's
	# directive order. Humans get 302→home; AI crawlers fall through to
	# the normal try_files + file_server below.
	@humanOnPress {
		path /press /press/*
		not header_regexp User-Agent (?i)(GPTBot|ClaudeBot|anthropic-ai|Claude-Web|PerplexityBot|CCBot|Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Applebot|facebookexternalhit|Twitterbot|LinkedInBot|Sogou|SemrushBot|AhrefsBot|Bytespider|PetalBot|Yisouspider|360Spider|DotBot|MJ12bot)
	}
	redir @humanOnPress / 302

	@humanOnGlossary {
		path /glossary /glossary/*
		not header_regexp User-Agent (?i)(GPTBot|ClaudeBot|anthropic-ai|Claude-Web|PerplexityBot|CCBot|Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Applebot|facebookexternalhit|Twitterbot|LinkedInBot|Sogou|SemrushBot|AhrefsBot|Bytespider|PetalBot|Yisouspider|360Spider|DotBot|MJ12bot)
	}
	redir @humanOnGlossary / 302

	# SPA + prerendered static files:
	# 1. Try exact file (e.g. /about/index.html)
	# 2. Try directory index (e.g. /about/ -> /about/index.html)
	# 3. Fall back to index.html (SPA client-side routing)
	#
	# IMPORTANT: 子路径部署（如 /lollipop/）下，Caddy 的 try_files {path}/ 不会自动
	# 追加 index.html，必须显式列出 /index.html 到 try_files，并在 file_server 中
	# 配置 index 指令，才能正确匹配预渲染的目录索引文件。
	# 否则 /about、/genre/romance 等无斜杠路径会 fallback 到首页 index.html，
	# 导致所有子页面返回首页的 SEO 标签（重复内容风险）。
	try_files {path} {path}/index.html /index.html

	# Serve pre-compressed .br/.gz files when available (build 阶段预生成)
	file_server {
		index index.html
		precompressed zstd gzip
	}

	# Cache static assets aggressively (hashed filenames are immutable)
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML files — revalidate to pick up new deploys
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# robots.txt and sitemap.xml — serve from root
	@seo path /robots.txt /sitemap.xml
	header @seo Cache-Control "public, max-age=3600"
}


# 非www → www 301重定向
0yuan.top {
	redir https://www.0yuan.top{uri} 301
}

smartcs.site {
	redir https://www.smartcs.site{uri} 301
}

aigeo.store {
	redir https://www.aigeo.store{uri} 301
}

www.0yuan.top {
	encode gzip zstd
	header {
		Cache-Control "public, max-age=3600"
		X-Content-Type-Options "nosniff"
	}
	@static {
		path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.eot *.webp
	}
	header @static Cache-Control "public, max-age=86400"

	# 死链路径 301 → 首页
	@deadPath path_regexp ^/(pc|new|hot|blog|tag|topic)/?$
	redir @deadPath / 301

	# 爬虫 UA 匹配 — 各大搜索引擎 + 常见工具爬虫
	# 扫描器/攻击路径：直接返回 403，不浪费跳转资源
	@scanner path_regexp (?i)(\.(env|bak|backup|sql|old|ini|cfg|conf|log|zip|tar|gz|rar|7z|svn|git|ssh|htaccess|htpasswd|php|asp|aspx|jsp|cgi|py|sh)$|/(wp-admin|wp-login|xmlrpc|phpmyadmin|administrator|manager|console|graphql|cgi-bin|actuator|aws-exports|appsettings|web\.config|privatekey|id_rsa|id_ecdsa|authorized_keys|known_hosts|docker-compose|\.vscode|\.idea|\.github)|@fs|__vite|ngsw\.json|wp-json|wp-filemanager|wp-content/plugins/hellopress)
	handle @scanner {
		respond 403
	}



	@bot {
		header_regexp User-Agent (?i)(bot|crawler|spider|scanner|slurp|baiduspider|bingbot|googlebot|duckduckbot|yandex|sogou|facebookexternalhit|twitterbot|rogerbot|linkedinbot|embedly|quora|pinterest|slack|whatsapp|telegrambot|ia_archiver|petalbot|ahrefsbot|semrushbot|dotbot|mj12bot|yisouspider|360spider|haosouspider|bytespider)
	}

	# 爬虫：返回静态伪原创 HTML（不走跳转）
	handle @bot {
		root * /home/ubuntu/zhanqun/data/1/html3
		file_server
	}

	# 真人用户：302 直跳 18rwan.site 并保留原路径（去掉 18rwan.com 中间跳板，修复 utm 归因断裂 + 深链保真）
	handle {
		redir * https://www.18rwan.site{uri}?utm_source=www.0yuan.top 302
	}
}

www.smartcs.site {
	encode gzip zstd
	header {
		Cache-Control "public, max-age=3600"
		X-Content-Type-Options "nosniff"
	}
	@static {
		path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.eot *.webp
	}
	header @static Cache-Control "public, max-age=86400"
	handle /BingSiteAuth.xml {
		respond `<?xml version="1.0"?>
<users>
    <user>436DCA41B84067E9A8158AC5FF0F8D0F</user>
</users>`
	}
	reverse_proxy localhost:8080
}

