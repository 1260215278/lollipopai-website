# ── mingfu (铭伏科技) — 储能/锂电池/混合逆变器 五语言静态站 (EN根+ZH/ES/AR/FR) 2026-09-10 ──
# 纯相对路径构建(assets/... ../assets/...)，子路径部署无需改 HTML
# http:// 前缀禁用 auto-HTTPS → IP 直连不被 308 劫持
:80 {
	# ── bonjourluxe 绝对路径 → /bonjourluxe/ 前缀（先于 mingfu 规则）──
	# PHP 模板中 $TemplatePath 和部分链接不包含 APP_BASE 前缀
	@bonjourAbs path /template /template/* /en /en/* /product /product/* /news /news/* /guide /guide/* /guide.html /history.html /honor.html /market.html /material.html /workmanship.html /yanshengzhoubian.html /yunxixilie.html /fanxingxilie.html /lumingxilie.html /upload /upload/* /include /include/* /cn /cn/*
	redir @bonjourAbs /bonjourluxe{uri} 301

	# ── lollipop 绝对路径资源 → /lollipop/ 前缀 ──
	# lollipop SPA 构建产物用绝对路径 /assets/、/blog-images/、/favicon
	@lollipopAbs path /assets /assets/* /blog-images /blog-images/* /favicon.png /favicon-32.png /favicon-32.webp /favicon.svg /favicon.ico
	redir @lollipopAbs /lollipop{uri} 301

	# ── lollipop SPA 客户端路由 → /lollipop/ 前缀 ──
	# React Router 用绝对路径 /about、/blog、/drama/xxx 等，需重定向到子路径
	@lollipopRoutes path /about /blog /blog/* /contact /creating /distribution /download /login /privacy /terms /press /press/* /glossary /glossary/* /drama /drama/* /genre /genre/*
	redir @lollipopRoutes /lollipop{uri} 301

	# ── mingfu 语言重定向 ──
	@langroot path_regexp ^/(zh|es|ar|fr)(/.*)?$
	redir @langroot /mingfu{uri} 301

	# ── mingfu 根路径 .html → /mingfu/ 前缀 ──
	# 只匹配 mingfu 实际存在的 html 文件，排除已被上面处理的路径
	@mingfuHtml path_regexp ^/(about|application|certificates|contact|downloads|news|products|solutions)\.html$
	redir @mingfuHtml /mingfu{uri} 301

	# ── mingfu (铭伏科技) 五语言静态站 ──
	handle_path /mingfu* {
		root * /srv/www/mingfu/current
		encode gzip zstd
		header {
			X-Content-Type-Options "nosniff"
			-Server
		}
		@static path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.eot *.webp *.mp4 *.pdf
		header @static Cache-Control "public, max-age=86400"
		@html path *.html
		header @html Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}/index.html
		file_server
	}

	# ── lollipop (AI 竖短剧) 静态站 ──
	handle_path /lollipop* {
		root * /srv/www/lollipop/current
		encode gzip zstd
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Cache-Control "public, max-age=3600"
		}
		try_files {path} {path}/index.html /index.html
		file_server {
			index index.html
			precompressed zstd gzip
		}
	}

	# ── bonjourluxe (奢侈品导购) PHP 站 ──
	handle_path /bonjourluxe* {
		root * /srv/www/bonjourluxe/current
		encode gzip zstd
		php_fastcgi unix//run/php/php7.4-fpm.sock {
			env DB_HOST 127.0.0.1
			env DB_USER bonjourluxe_com
			env DB_PASSWORD GSfMf7AYSKQsEZYz
			env DB_NAME bonjourluxe_com
			env APP_BASE /bonjourluxe
		}
		file_server
	}

	# ── bisenfan (毕森凡) 静态站 ──
	handle_path /bisenfan* {
		root * /srv/www/bisenfan/current
		encode gzip zstd
		header {
			X-Content-Type-Options "nosniff"
			Cache-Control "no-cache"
		}
		try_files {path} {path}/index.html
		file_server
	}


	# ── www.lollipop.im 根路径 (CF Flexible SSL 走 port 80) ──
	@lollipopHost host www.lollipop.im
	handle @lollipopHost {
		root * /srv/www/lollipop/current
		encode gzip zstd
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			# 2026-10-27 CF cache 问题：此前 max-age=0 must-revalidate 不够，
			# CF Flexible SSL 仍缓存旧内容。改用 no-store 强制每次回源验证。
			Cache-Control "no-cache, no-store, must-revalidate"
			Pragma "no-cache"
			Expires "0"
		}
		try_files {path} {path}/index.html /index.html
		file_server {
			index index.html
			precompressed gzip zstd
		}
	}
	# ── 根路径首页 ──
	handle {
		root * /srv/www/_root
		file_server {
			index index.html
		}
	}
}
