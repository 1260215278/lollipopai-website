# ── 短剧发行中心 环境变量 ──────────────────────────────
# 后端域名（联调前替换；留空则走相对路径 /sqx_fast，可配合 dev 代理）
VITE_API_BASE=

# 业务数据 mock 开关：true=用本地 mock（数据概览/上剧/结算），false=走真实接口
# 入驻模块（publisher）始终走真接口，不受此开关影响
VITE_USE_MOCK=true

# 鉴权模式：mock=使用本地 mock token；real=登录接口就绪后从登录态取 token
VITE_AUTH_MODE=mock

# mock 模式下注入的用户 JWT（联调真入驻接口时填入后端下发的真实 token）
VITE_MOCK_TOKEN=
